using Gtk 4.0;
using Adw 1;

template $AppWindow : Adw.ApplicationWindow {
  default-width: 1100;
  default-height: 700;
  width-request: 360;
  height-request: 300;
  title: _("Clips");

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar headerbar {
      [end]
      Button toggle_sidebar_button {
        icon-name: 'sidebar-show-symbolic';
        tooltip-text: _("Toggle Sidebar");
        visible: false;
        styles ['flat']
      }

      MenuButton {
        icon-name: "open-menu-symbolic";
        menu-model: primary_menu;
        tooltip-text: _("Main Menu");
        primary: true;
      }

      styles ["flat"]
    }

    content:
    Stack stack {
      transition-type: crossfade;

      StackPage {
        name: "welcome";
        child:
        Adw.StatusPage {
          icon-name: "io.gitlab.adhami3310.Clips";
          title: _("Clips");
          description: _("Choose a video to edit");
          hexpand: true;
          vexpand: true;
          child:
          Box {
            orientation: vertical;
            spacing: 12;

            Box welcome_drop_zone {
              orientation: vertical;
              spacing: 10;
              halign: center;
              width-request: 380;
              margin-top: 12;
              margin-bottom: 12;
              tooltip-text: _("Drop a video file here");

              Image {
                halign: center;
                icon-name: "camera-video-symbolic";
                pixel-size: 40;
              }

              Label {
                halign: center;
                label: _("Drag and drop a video here");
                justify: center;
                wrap: true;
              }

              Label {
                halign: center;
                label: _("Open it directly without using the button");
                justify: center;
                wrap: true;
                styles ["dim-label"]
              }

              styles [
                "card",
                "welcome-drop-zone",
              ]
            }

            Button open_video_button {
              valign: center;
              halign: center;
              label: _("Open Video…");
              action-name: "win.open";
              use-underline: true;

              styles [
                "suggested-action",
                "pill",
              ]
            }
          }

          ;
        }

        ;
      }

      StackPage {
        name: "invalid";
        child:
        Adw.StatusPage invalid_image {
          icon-name: "image-missing-symbolic";
          title: _("Could not Load Video");
          description: _("This video could be corrupted or may use an unsupported file format.");
          hexpand: true;
          vexpand: true;
        }

        ;
      }


      StackPage {
        name: "editing";
        child:
        Box editor_split_view {
          orientation: horizontal;
          hexpand: true;
          vexpand: true;

          Box editor_content {
            orientation: vertical;
            spacing: 12;
            hexpand: true;
            vexpand: true;
            margin-start: 12;
            margin-end: 12;
            margin-top: 12;
            margin-bottom: 12;

            $VideoPreview video_preview {
              hexpand: true;
              vexpand: true;
            }

            Box playback_row {
              spacing: 12;
              Button play_pause {
                icon-name: 'play-symbolic';
                tooltip-text: 'Play';
              }
              $Timeline timeline {}
            }

            Box {
              halign: center;
              spacing: 12;
              Button rotate_left_button {
                halign: center;
                icon-name: 'object-rotate-left-symbolic';
                tooltip-text: _("Rotate Left");
              }
              Button rotate_right_button {
                halign: center;
                icon-name: 'object-rotate-right-symbolic';
                tooltip-text: _("Rotate Right");
              }
              Button horizontal_flip_button {
                halign: center;
                icon-name: 'horizontal-flip-symbolic';
                tooltip-text: _("Flip Horizontally");
              }
              Button vertical_flip_button {
                halign: center;
                icon-name: 'vertical-flip-symbolic';
                tooltip-text: _("Flip Vertically");
              }
              ToggleButton audio_button {
                halign: center;
                icon-name: 'audio-volume-high-symbolic';
                tooltip-text: _("Disable Audio");
              }
            }
          }

          Revealer settings_sidebar_revealer {
            reveal-child: true;
            transition-type: slide_left;

            [child]
            Box settings_sidebar {
              orientation: vertical;
              width-request: 320;

              Adw.ViewSwitcher {
                stack: sidebar_pages;
                policy: wide;
                margin-start: 12;
                margin-end: 12;
                margin-top: 12;
                margin-bottom: 8;
              }

              Separator {}

              Adw.ViewStack sidebar_pages {
                vexpand: true;

                Adw.ViewStackPage {
                  name: "sections";
                  title: _("Sections");
                  icon-name: "view-list-symbolic";
                  child:
                  ScrolledWindow {
                    hscrollbar-policy: never;
                    vscrollbar-policy: automatic;

                    Adw.Clamp {
                      maximum-size: 400;
                      margin-start: 12;
                      margin-end: 12;
                      margin-top: 12;
                      margin-bottom: 12;

                      Box {
                        orientation: vertical;
                        spacing: 12;

                        Label {
                          label: _("Select a section to edit it in the timeline. The list order is the export order.");
                          wrap: true;
                          xalign: 0;
                          styles ["dim-label"]
                        }

                        ListBox sections_list {
                          selection-mode: single;
                          styles ["boxed-list"]
                        }

                        Box {
                          spacing: 8;
                          homogeneous: true;

                          Button remove_segment_button {
                            label: _("Remove");
                            tooltip-text: _("Remove Current Section");
                            sensitive: false;
                          }

                          Button add_segment_button {
                            label: _("Add Section");
                            tooltip-text: _("Add Section at Playhead");
                            styles ["suggested-action"]
                          }
                        }
                      }
                    }
                  }
                  ;
                }

                Adw.ViewStackPage {
                  name: "video";
                  title: _("Video");
                  icon-name: "image-x-generic-symbolic";
                  child:
                  ScrolledWindow {
                    hscrollbar-policy: never;
                    vscrollbar-policy: automatic;

                    Adw.Clamp {
                      maximum-size: 400;
                      margin-start: 12;
                      margin-end: 12;
                      margin-top: 12;
                      margin-bottom: 12;

                      Box {
                        orientation: vertical;
                        spacing: 24;

                        ListBox {
                          selection-mode: none;
                          styles ["boxed-list"]

                          Adw.ActionRow resize_amount_row {
                            title: _("Resize");
                            Box {
                              spacing: 5;
                              Entry resize_width_value {
                                valign: center;
                                placeholder-text: _("Width");
                                tooltip-text: _("Width");
                                input-purpose: digits;
                                max-width-chars: 6;
                                visible: false;
                                hexpand: false;
                              }
                              Entry resize_scale_width_value {
                                valign: center;
                                placeholder-text: _("Width");
                                input-purpose: digits;
                                tooltip-text: _("Width");
                                max-width-chars: 6;
                                hexpand: false;
                              }
                              Image link_axis {
                                valign: center;
                                icon-name: 'chain-link-symbolic';
                                tooltip-text: _("Preserve aspect ratio");
                                styles ['lock']
                              }
                              Entry resize_height_value {
                                valign: center;
                                placeholder-text: _("Height");
                                tooltip-text: _("Height");
                                input-purpose: digits;
                                max-width-chars: 6;
                                visible: false;
                                hexpand: false;
                              }
                              Entry resize_scale_height_value {
                                valign: center;
                                placeholder-text: _("Height");
                                input-purpose: digits;
                                tooltip-text: _("Height");
                                max-width-chars: 6;
                                hexpand: false;
                              }
                            }
                            Adw.Bin {
                              Box {
                                DropDown resize_type {
                                  valign: center;
                                  accessibility {
                                    label: _("Choose between resizing with percentages or using exact pixels");
                                  }
                                  model:
                                  StringList resize_types {
                                    strings [_("%"),_("px")]
                                  }
                                  ;
                                  styles ["flat", "unit-drop"]
                                }
                              }
                            }
                          }

                          Adw.SwitchRow enhance_quality_row {
                            title: _("Improve Quality");
                            subtitle: _("Export at 2× with high-quality upscaling");
                          }

                          Adw.SpinRow framerate_row {
                            title: _("Framerate");
                            adjustment: Adjustment {
                              lower: 1;
                              step-increment: 1;
                              upper: 480;
                            }
                            ;
                            value: 30;
                          }
                        }

                        ListBox {
                          selection-mode: none;
                          styles ["boxed-list"]

                          Adw.ExpanderRow adjustments_row {
                            title: _("Image Adjustments");
                            subtitle: _("Brightness, contrast, colour, sharpness");

                            Adw.ActionRow {
                              title: _("Brightness");
                              Scale adjust_brightness {
                                valign: center;
                                hexpand: true;
                                width-request: 150;
                                draw-value: true;
                                value-pos: right;
                                digits: 2;
                                adjustment: Adjustment {
                                  lower: -1;
                                  upper: 1;
                                  step-increment: 0.01;
                                  page-increment: 0.1;
                                  value: 0;
                                };
                              }
                            }

                            Adw.ActionRow {
                              title: _("Contrast");
                              Scale adjust_contrast {
                                valign: center;
                                hexpand: true;
                                width-request: 150;
                                draw-value: true;
                                value-pos: right;
                                digits: 2;
                                adjustment: Adjustment {
                                  lower: 0;
                                  upper: 2;
                                  step-increment: 0.01;
                                  page-increment: 0.1;
                                  value: 1;
                                };
                              }
                            }

                            Adw.ActionRow {
                              title: _("Saturation");
                              Scale adjust_saturation {
                                valign: center;
                                hexpand: true;
                                width-request: 150;
                                draw-value: true;
                                value-pos: right;
                                digits: 2;
                                adjustment: Adjustment {
                                  lower: 0;
                                  upper: 2;
                                  step-increment: 0.01;
                                  page-increment: 0.1;
                                  value: 1;
                                };
                              }
                            }

                            Adw.ActionRow {
                              title: _("Hue");
                              Scale adjust_hue {
                                valign: center;
                                hexpand: true;
                                width-request: 150;
                                draw-value: true;
                                value-pos: right;
                                digits: 0;
                                adjustment: Adjustment {
                                  lower: -180;
                                  upper: 180;
                                  step-increment: 1;
                                  page-increment: 15;
                                  value: 0;
                                };
                              }
                            }

                            Adw.ActionRow {
                              title: _("Gamma");
                              Scale adjust_gamma {
                                valign: center;
                                hexpand: true;
                                width-request: 150;
                                draw-value: true;
                                value-pos: right;
                                digits: 2;
                                adjustment: Adjustment {
                                  lower: 0.1;
                                  upper: 4;
                                  step-increment: 0.01;
                                  page-increment: 0.1;
                                  value: 1;
                                };
                              }
                            }

                            Adw.ActionRow {
                              title: _("Sharpness");
                              Scale adjust_sharpness {
                                valign: center;
                                hexpand: true;
                                width-request: 150;
                                draw-value: true;
                                value-pos: right;
                                digits: 2;
                                adjustment: Adjustment {
                                  lower: 0;
                                  upper: 1;
                                  step-increment: 0.01;
                                  page-increment: 0.1;
                                  value: 0;
                                };
                              }
                            }

                            Adw.ButtonRow adjustments_reset {
                              title: _("Reset Adjustments");
                            }
                          }

                          Adw.ComboRow repeat_row {
                            title: _("Repeat");
                            model: StringList {};
                            styles ["property"]
                          }

                          Adw.ComboRow speed_row {
                            title: _("Speed");
                            subtitle: _("Change video and audio speed");
                            model: StringList {};
                            styles ["property"]
                          }

                          Adw.SpinRow repeat_count_row {
                            title: _("Cycles");
                            visible: false;
                            adjustment: Adjustment {
                              lower: 1;
                              upper: 50;
                              step-increment: 1;
                              value: 2;
                            };
                            value: 2;
                          }
                        }
                      }
                    }
                  }
                  ;
                }

                Adw.ViewStackPage {
                  name: "export";
                  title: _("Export");
                  icon-name: "document-save-symbolic";
                  child:
                  ScrolledWindow {
                    hscrollbar-policy: never;
                    vscrollbar-policy: automatic;

                    Adw.Clamp {
                      maximum-size: 400;
                      margin-start: 12;
                      margin-end: 12;
                      margin-top: 12;
                      margin-bottom: 12;

                      Box {
                        orientation: vertical;
                        spacing: 24;

                        ListBox {
                          selection-mode: none;
                          styles ["boxed-list"]

                          Adw.ComboRow segment_export_mode {
                            title: _("Multiple Sections");
                            subtitle: _("Export order follows the section list");
                            visible: false;
                            model: StringList {};
                            styles ["property"]
                          }

                          Adw.ComboRow container_row {
                            title: _("Container Format");
                            use-subtitle: true;
                            model: StringList {};
                            styles ["property"]
                          }
                          Adw.ComboRow video_encoding {
                            title: _("Video Encoding");
                            use-subtitle: true;
                            model: StringList {};
                            styles ["property"]
                          }
                          Adw.ComboRow audio_encoding {
                            title: _("Audio Encoding");
                            use-subtitle: true;
                            model: StringList {};
                            styles ["property"]
                          }
                          Adw.ComboRow quality_row {
                            title: _("Quality");
                            use-subtitle: true;
                            model:
                            StringList quality_list {
                              strings [_("Low"), _("Medium"), _("High"), _("Unchanged")]
                            }
                            ;
                            selected: 2;
                            styles ["property"]
                          }
                          Adw.SwitchRow gpu_row {
                            title: _("Hardware Acceleration");
                            subtitle: _("Use the GPU (NVENC) when the codec supports it");
                            active: true;
                          }
                          Adw.ActionRow encoder_status_row {
                            title: _("Encoder");
                            subtitle: _("…");
                            styles ["property"]

                            [prefix]
                            Image encoder_status_icon {
                              icon-name: "power-profile-performance-symbolic";
                            }
                          }
                        }

                        Button save_button {
                          halign: center;
                          label: _("Save Video");
                          styles ["suggested-action", "pill"]
                        }
                      }
                    }
                  }
                  ;
                }
              }
            }
          }
        }

        ;
      }

      StackPage {
        name: "loading";
        child:
        Adw.Spinner spinner {
          valign: center;
          halign: center;
          height-request: 28;
          width-request: 28;
        }

        ;
      }

      StackPage {
        name: "success";
        child:
        Adw.StatusPage success_status {
          icon-name: "check-round-outline-symbolic";
          title: _("Video Exported");
          child:
          Box {
            orientation: vertical;
            halign: center;
            spacing: 12;

            Button open_result {
              valign: center;
              halign: center;
              label: _("Open");
              use-underline: true;
              width-request: 220;

              styles [
                "suggested-action",
                "pill",
              ]
            }

            Button reveal_result {
              valign: center;
              halign: center;
              label: _("Show in Folder");
              use-underline: true;
              width-request: 220;

              styles [
                "pill",
              ]
            }

            Button edit_result {
              valign: center;
              halign: center;
              label: _("Back to Editing");
              use-underline: true;
              width-request: 220;

              styles [
                "pill",
              ]
            }

            Button done_button {
              valign: center;
              halign: center;
              label: _("Finish");
              use-underline: true;
              width-request: 220;

              styles [
                "pill",
              ]
            }
          }

          ;
        }

        ;
      }

      StackPage {
        name: "failure";
        child:
        Adw.StatusPage {
          icon-name: "error-symbolic";
          title: _("Exporting Video Unsuccessful");
          child:
          Box {
            orientation: vertical;
            spacing: 12;

            Button try_again_button {
              valign: center;
              halign: center;
              label: _("Retry");
              use-underline: true;

              styles [
                "suggested-action",
                "pill",
              ]
            }
          }

          ;
        }

        ;
      }

      StackPage {
        name: "exporting";
        child:
        Adw.StatusPage exporting_page {
          title: _("Rendering");
          icon-name: "camera-video-symbolic";
          description: _("This may take a while");

          Box {
            orientation: vertical;
            spacing: 36;

            ProgressBar progress_bar {
              valign: center;
              halign: center;
              show-text: true;
            }

            Button cancel_button {
              valign: center;
              halign: center;
              label: _("_Cancel");
              use-underline: true;

              styles [
                "pill",
              ]
            }
          }
        }

        ;
      }
    }

    ;
  }

  [breakpoint]
  Adw.Breakpoint {
    condition("max-width: 720sp")
    setters {
      editor_split_view.orientation: vertical;
      settings_sidebar_revealer.transition-type: slide_up;
      settings_sidebar_revealer.reveal-child: true;
      settings_sidebar.width-request: 0;
      settings_sidebar.hexpand: true;
      settings_sidebar.height-request: 300;
      settings_sidebar.vexpand: false;
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("Open Video…");
      action: "win.open";
    }

    item {
      label: _("New Window");
      action: "app.new-window";
    }
  }

  section {
    item {
      label: _("Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("About Clips");
      action: "win.about";
    }
  }
}
